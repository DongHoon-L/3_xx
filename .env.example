# ---- rag-agent ----
# token:actor:role, 쉼표로 여러 개. 토큰 생성: python -c "import secrets; print(secrets.token_urlsafe(24))"
RAG_API_KEYS=
LLM_PROVIDER=openai_compat          # openai_compat | mock
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=512
LLM_DISABLE_THINKING=true
RAG_TOP_K=2
RAG_MAX_QUESTION_CHARS=2000
# RAG_DOCUMENTS_PATH=rag-agent/rag_agent/data/documents.json

# ---- audit-engine ----
# 16자 이상 임의 문자열. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_PSEUDONYM_SECRET=
# 32바이트 base64. 생성: ../../prism/Scripts/python.exe -m audit_engine keygen
AUDIT_KEK_B64=
AUDIT_CHAIN_PATH=./audit-data/chain.jsonl
AUDIT_VAULT_PATH=./audit-data/vault.json
AUDIT_HASH_ALGORITHM=sha256          # sha256 | sha512 | sha3_256
# AUDIT_RETENTION_POLICY=audit-engine/audit_engine/policies/retention_policy.json
